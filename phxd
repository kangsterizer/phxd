#!/usr/bin/env python

from __future__ import absolute_import
from __future__ import print_function
import sys
import traceback
from twisted.internet import reactor
from server.HLServer import HLServer
from shared.HLTypes import *
import server.handlers

serv = HLServer()

for modName in server.handlers.__all__:
    try:
        mod = __import__( "server.handlers.%s" % modName , None , None , "server.handlers" )
        mod.installHandler( serv )
        serv.log.debug( "Loaded handler: %s" , modName )
    except Exception:
        # Don't swallow the real reason a handler failed to load — print
        # the full traceback so you can see syntax errors, missing deps,
        # etc. in ``docker logs``.
        print( "error importing server.handlers.%s" % modName , file = sys.stderr )
        traceback.print_exc()

serv.logEvent( LOG_TYPE_GENERAL , "Server started on port %d" % serv.port )
print( "phxd listening on TCP %d (default accounts: admin/adminpass, guest/<no password>)" % serv.port , flush = True )
reactor.run()
serv.logEvent( LOG_TYPE_GENERAL , "Server stopped" )
